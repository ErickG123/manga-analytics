# Configuração do PostgreSQL 17
POSTGRES_DB=manga_atlas
POSTGRES_USER=manga_atlas
POSTGRES_PASSWORD=manga_atlas_secret
POSTGRES_PORT=5432

# URL de Conexão com o Banco (TypeORM e Coletor Python)
DATABASE_URL=postgresql://manga_atlas:manga_atlas_secret@localhost:5432/manga_atlas?schema=public

# Configuração da API Fastify
API_PORT=3333
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:4200
ADMIN_API_KEY=atlas_admin_secret_token_2026

# Configuração do Frontend Angular
API_BASE_URL=http://localhost:3333/api/v1

# Configuração do Coletor Python
COLLECTOR_ENABLED=true
COLLECTOR_BASE_URL=https://blogbbm.com/wp-json/wp/v2/pages
COLLECTOR_PARENT_CATALOG_ID=82066
COLLECTOR_MIN_REQUEST_INTERVAL_SECONDS=5.0
COLLECTOR_MAX_CONCURRENCY=1
COLLECTOR_MAX_RETRIES=3
COLLECTOR_HTTP_RETRY_BASE_DELAY_SECONDS=5
COLLECTOR_HTTP_RETRY_MAX_DELAY_SECONDS=60
COLLECTOR_RATE_LIMIT_FALLBACK_SECONDS=900
COLLECTOR_DRY_RUN=false
# Opcionais para execução do Collector pelo painel Admin. Por padrão: `py` no Windows,
# `python3` nos demais sistemas; raiz do projeto = diretório de trabalho da API.
COLLECTOR_PYTHON_EXECUTABLE=py
COLLECTOR_PROJECT_ROOT=.
