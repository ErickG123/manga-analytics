{
  "name": "manga-atlas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "test": "ng test",
    "test:watch": "ng test --watch",
    "test:coverage": "ng test --watch=false --coverage",
    "test:api": "vitest run apps/api/src/app.spec.ts apps/api/src/modules/admin/collector-runner.service.spec.ts apps/api/src/modules/manga/services/manga.service.spec.ts",
    "test:collector": "python -m pytest collector/tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . && node scripts/check-no-ui-emojis.mjs",
    "lint:fix": "eslint . --fix",
    "lint:collector": "python -m ruff check collector",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:seed": "tsx apps/api/src/seed.ts",
    "api:start": "tsx --tsconfig apps/api/tsconfig.json apps/api/src/server.ts",
    "check": "npm run format:check && npm run lint && npm run test -- --watch=false && npm run test:api && npm run build"
  },
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/sensible": "^6.0.3",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.2",
    "@primeuix/themes": "^2.0.3",
    "dotenv": "^16.4.7",
    "echarts": "^5.6.0",
    "fastify": "^5.2.1",
    "pg": "^8.13.3",
    "primeicons": "^8.0.2",
    "primeng": "^21.1.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@angular/build": "^21.0.0",
    "@angular/cli": "^21.0.0",
    "@angular/compiler-cli": "^21.0.0",
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@vitest/coverage-v8": "^4.0.8",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.0",
    "tsx": "^4.19.3",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.24.0",
    "vitest": "^4.0.8"
  }
}
